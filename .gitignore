# 依赖
node_modules/
.pnpm-store/

# 构建产物
docs/.vitepress/dist/
docs/.vitepress/cache/
docs/.vitepress/.temp/
# Vite 构建期生成的临时配置文件
docs/.vitepress/config.mts.timestamp-*.mjs

# 开发临时文件
.dev/

# Agent 工作数据（记忆等本机状态，不上传）
.workbuddy/*
# 例外：项目级 skill 随仓库分发，供下一届接力开发的 agent 在 clone 后自动发现加载
!.workbuddy/skills/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 本地环境
.env
.env.local
.env.*.local
